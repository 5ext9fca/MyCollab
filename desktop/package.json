{
  "name": "mycollab-companion",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 1420 --strictPort",
    "build": "vue-tsc --noEmit && vite build",
    "test": "vitest run",
    "tauri": "tauri",
    "sidecar": "../backend/.venv/bin/python scripts/build_sidecar.py",
    "bundle": "npm run sidecar && tauri build --features custom-protocol --bundles app"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "vue": "^3.5",
    "element-plus": "^2"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@vitejs/plugin-vue": "^6",
    "vite": "^8",
    "typescript": "~6.0",
    "vue-tsc": "^3",
    "vitest": "^5",
    "@vue/test-utils": "^2",
    "jsdom": "^30"
  }
}
