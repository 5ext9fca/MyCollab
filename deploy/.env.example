# Copy to .env and replace every value. Never commit the real .env.
DJANGO_SECRET_KEY=replace-with-a-long-random-string
POSTGRES_PASSWORD=replace-with-a-strong-password
# Public hostname Caddy serves and Django accepts.
DOMAIN=missions.example.com
DJANGO_ALLOWED_HOSTS=missions.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://missions.example.com
POSTGRES_DB=mycollab
POSTGRES_USER=mycollab

# 待办与日期提醒的自然日时区
DJANGO_TIME_ZONE=UTC
